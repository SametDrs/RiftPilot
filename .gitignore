# ==============================================================================
# RiftPilot - Root .gitignore
# ==============================================================================

# Operating System Files
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# IDEs and Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Environment Variables & Secrets (CRITICAL SECURITY)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json

# LoL Client Local Extracted Data (Avoid committing local runtime tokens)
lockfile
*.lockfile

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node.js / TypeScript
node_modules/
jspm_packages/
dist/
build/
out/
.next/
.nuxt/
.cache/
.turbo/
.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Rust / Go / C++
target/
bin/
*.exe
*.dll
*.so
*.dylib

# Test Coverage
coverage/
.nyc_output/
*.lcov
